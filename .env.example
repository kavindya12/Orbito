###############################################################################
# Orbito – Environment Variables
#
#   API:      apps/api/.env
#   Frontend: apps/web/.env
###############################################################################

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local (Docker): docker compose up -d
DATABASE_URL=postgresql://orbito:orbito@localhost:5432/orbito

# Render / Neon / Railway will provide their own DATABASE_URL automatically.

# -----------------------------------------------------------------------------
# API server (apps/api/.env)
# -----------------------------------------------------------------------------
PORT=4000

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# File uploads – Cloudinary (optional)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# AI features – OpenAI (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Frontend (apps/web/.env)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
