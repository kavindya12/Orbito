# Database (SQLite for local; use PostgreSQL URL in production)
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://orbito:orbito@localhost:5432/orbito

# API
PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cloudinary (optional — local file fallback if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (optional — heuristic fallback if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend (apps/web/.env)
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
