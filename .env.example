###############################################################################
# Orbito – Environment Variables
#
# Copy this file to the locations below, then fill in the values you need.
#
#   API:      apps/api/.env     (copy the Database + API + Cloudinary + AI sections)
#   Frontend: apps/web/.env     (copy the Frontend section only)
#
# Required for local development: DATABASE_URL, PORT, JWT secrets, CORS_ORIGIN,
# VITE_API_URL, and VITE_SOCKET_URL.
# Optional: Cloudinary and OpenAI (the app falls back gracefully if they are empty).
###############################################################################

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development uses SQLite (no Docker required).
DATABASE_URL=file:./dev.db

# For production, use PostgreSQL instead (e.g. Neon, Railway, or local Docker):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/orbito

# -----------------------------------------------------------------------------
# API server (apps/api/.env)
# -----------------------------------------------------------------------------
PORT=4000

# JWT secrets – use long random strings in production (at least 32 characters).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# Where the frontend runs (used for redirects / links).
CLIENT_URL=http://localhost:5173

# Allowed browser origins for CORS. Comma-separated.
# Include every Vite port you use locally (5173, 5174, …).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# File uploads – Cloudinary (optional)
# -----------------------------------------------------------------------------
# If these are empty, files are stored under apps/api/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# AI features – OpenAI (optional)
# -----------------------------------------------------------------------------
# If OPENAI_API_KEY is empty, Orbito uses built-in heuristic fallbacks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Frontend (apps/web/.env)
# -----------------------------------------------------------------------------
# Must point at the running API. Restart Vite after changing these.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
